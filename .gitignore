# Runtime files created by PHP on the server
public/api/state.json
public/api/state.lock
public/api/pool-cache*.json   # versioned caches (pool-cache.v3.json etc.)
public/api/quota-usage.json       # daily YouTube API quota counter
public/api/quota-usage.json.lock  # lock file for quota tracker
logs/                          # perf.log, rate-limit.json

# Dependencies (installed locally, not committed)
node_modules/
vendor/

# Environment variables
.env
.env.local

# OS artifacts
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
